{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/mxmaster-cfg/profile.schema.json",
  "title": "MX Master profile (MVP)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Bump when breaking profile fields."
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "transport": {
          "type": "string",
          "enum": ["bolt", "bluetooth", "any"],
          "description": "Hint only; not app-specific. MVP has no per-app profiles."
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "logiops device name match, e.g. MX Master 3S"
        },
        "family": {
          "type": "string",
          "enum": ["mx-master-3s", "mx-master-3", "mx-master-3-business", "mx-master-4", "mx-master-other"]
        },
        "pid_hint": {
          "type": "string",
          "description": "Optional USB/BT product id hint, e.g. 046d:b034"
        }
      }
    },
    "dpi": {
      "type": "integer",
      "minimum": 200,
      "maximum": 8000
    },
    "smartshift": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on": { "type": "boolean" },
        "threshold": { "type": "integer", "minimum": 1, "maximum": 50 },
        "torque": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "hiresscroll": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hires": { "type": "boolean" },
        "invert": { "type": "boolean" },
        "target": { "type": "boolean" }
      }
    },
    "buttons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cid", "action"],
        "properties": {
          "cid": {
            "description": "Control ID (int or hex string like 0xc3)",
            "oneOf": [
              { "type": "integer" },
              { "type": "string", "pattern": "^0[xX][0-9a-fA-F]+$" }
            ]
          },
          "label": { "type": "string" },
          "action": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "None",
                  "Keypress",
                  "Gestures",
                  "ToggleSmartShift",
                  "CycleDPI",
                  "ChangeDPI",
                  "ChangeHost"
                ]
              },
              "keys": {
                "type": "array",
                "items": { "type": "string" }
              },
              "gestures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["direction"],
                  "properties": {
                    "direction": {
                      "type": "string",
                      "enum": ["Up", "Down", "Left", "Right", "None"]
                    },
                    "mode": {
                      "type": "string",
                      "enum": ["OnRelease", "OnInterval", "Axis"]
                    },
                    "action": {
                      "type": "object",
                      "properties": {
                        "type": { "type": "string" },
                        "keys": {
                          "type": "array",
                          "items": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
