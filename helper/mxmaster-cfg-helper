    )


def cmd_set_smartshift(args: argparse.Namespace) -> int:
    """Live SmartShift via D-Bus. Prefer apply-cfg to persist across restart.

    ``SetActive(active, clear)``: second arg clear=true *unsets* config ``on``
    (GetConfig → 0). Always pass clear=false when enabling/disabling.

    GetConfig mode: 0=unset, 1=off, 2=on. Bolt Set* often times out; readback
    is authoritative.
    """
    path = _device_index_path(args.device)
    errors: list[str] = []

    def _try_call(label: str, *call_args: str) -> None:
        try:
            _call(path, IFACE_SMARTSHIFT, *call_args, timeout=10.0)
        except Exception as exc:  # noqa: BLE001
            errors.append(f"{label}: {exc}")

    if args.on is not None:
        # NEVER pass clear=true here — that yields mode 0 (unset), not off.
        active = "true" if args.on == "true" else "false"
        _try_call("SetActive", "SetActive", "bb", active, "false")
    if args.threshold is not None:
        thr = int(args.threshold)
        if thr < 1 or thr > 50:
            return _fail("threshold out of range (1–50)")
        _try_call("SetThreshold", "SetThreshold", "yb", str(thr), "false")
    if args.torque is not None:
        support = _get_property(path, IFACE_SMARTSHIFT, "TorqueSupport")
        if not support:
            return _fail(
                "TorqueSupport=false on this device (MX Master 3S) — "
                "torque not applied; omit torque or use cfg only for docs"
            )
        _try_call("SetTorque", "SetTorque", "yb", str(int(args.torque)), "false")

    data = {"path": path, **_read_smartshift(path)}
    ss = data.get("smartshift") or {}
    matched = True
    if args.threshold is not None and int(ss.get("threshold", -1)) != int(args.threshold):
        matched = False
    if args.on is not None:
        want_on = args.on == "true"
        # mode 2 = on, mode 1 = off (explicit). mode 0 = unset ≠ either.
        got_mode = int(ss.get("mode", -1))
        if want_on and got_mode != 2:
            matched = False
        if (not want_on) and got_mode != 1:
            matched = False
    if matched and ss:
        if errors:
            data["dbus_warnings"] = errors
        return _ok(data)
    return _fail(
        "; ".join(errors) or "smartshift set failed",
        path=path,
        **{k: v for k, v in data.items() if k != "path"},
    )


def _wake_bolt_receiver() -> bool:
    """Soft-reset Logi Bolt USB (046d:c548) to encourage device re-detect."""
    import glob

    for vendor in glob.glob("/sys/bus/usb/devices/*/idVendor"):
        try:
            if Path(vendor).read_text().strip() != "046d":
                continue
            product = Path(vendor).with_name("idProduct")
            if product.read_text().strip() != "c548":
                continue
            auth = Path(vendor).with_name("authorized")
            if not auth.exists():
                continue
            auth.write_text("0")
            time.sleep(1.0)
            auth.write_text("1")
            return True
        except OSError:
            continue
    return False


def cmd_get_dpi(args: argparse.Namespace) -> int:
    path = _device_index_path(args.device)
    try:
        out = _call(path, IFACE_DPI, "GetDPI", "y", str(args.sensor), timeout=10.0)
        dpi = _parse_busctl_variant(out)
        return _ok({"path": path, "sensor": args.sensor, "dpi": dpi})
    except Exception as exc:  # noqa: BLE001
        return _fail(
            str(exc),
            path=path,
            hint="Move the mouse (Bolt re-detect / HID++ wake), then retry.",
        )


def cmd_set_dpi(args: argparse.Namespace) -> int:
    path = _device_index_path(args.device)
    dpi = int(args.dpi)
    if dpi < 200 or dpi > 8000:
        return _fail("dpi out of MX Master 3S range (200–8000)")
    try:
        _call(path, IFACE_DPI, "SetDPI", "qy", str(dpi), str(args.sensor), timeout=10.0)
        # read-back
        try:
            out = _call(path, IFACE_DPI, "GetDPI", "y", str(args.sensor), timeout=10.0)
            got = _parse_busctl_variant(out)
        except Exception:  # noqa: BLE001
            got = None
        return _ok({"path": path, "sensor": args.sensor, "dpi": dpi, "readback": got})
    except Exception as exc:  # noqa: BLE001
        return _fail(str(exc), path=path)


def _keypress_action_libconfig(keys: list[str]) -> str:
    quoted = ", ".join(f'"{k}"' for k in keys)
    return '{ type: "Keypress"; keys: [%s]; }' % quoted


def cmd_set_button_action(args: argparse.Namespace) -> int:
    """Live remap via Button.SetAction (string is libconfig action snippet)."""
    path = _device_index_path(args.device)
    # Find button object by ControlID
    buttons_root = f"{path}/buttons"
    r = _busctl(["call", SERVICE, path, IFACE_BUTTONS, "Enumerate"])
    if r.returncode != 0:
        # fall back to tree walk
        tree = _busctl(["tree", SERVICE])
        button_paths = [
            t
            for line in tree.stdout.splitlines()
            for t in line.split()
            if t.startswith(buttons_root + "/")
        ]
    else:
        # ao → paths
        button_paths = re.findall(r"/pizza/pixl/logiops/devices/\d+/buttons/\d+", r.stdout)

    target = None
    cid = int(args.cid, 0)
    for bp in sorted(set(button_paths)):
        try:
            control = _get_property(bp, IFACE_BUTTON, "ControlID")
        except RuntimeError:
            continue
        if int(control) == cid:
            target = bp
            break
    if not target:
        return _fail(f"button cid {hex(cid)} not found under {path}")

    if args.preset == "back":
        action = _keypress_action_libconfig(["KEY_BACK"])
    elif args.preset == "forward":
        action = _keypress_action_libconfig(["KEY_FORWARD"])
    elif args.preset == "none":
        action = '{ type: "None"; }'
    elif args.action:
        action = args.action
    else:
        return _fail("provide --preset or --action")

    try:
        _call(target, IFACE_BUTTON, "SetAction", "s", action, timeout=10.0)
        return _ok({"button": target, "cid": cid, "action": action})
    except Exception as exc:  # noqa: BLE001
        # Live SetAction string format is still unreliable on 0.3.5; MVP GUI
        # persists remaps via apply-cfg (write /etc/logid.cfg + restart).
        return _fail(
            str(exc),
            button=target,
            cid=cid,
            hint="Use apply-cfg for persistent remap on logiops 0.3.5",
        )


def cmd_apply_cfg(args: argparse.Namespace) -> int:
    """Write /etc/logid.cfg from file or stdin, backup, restart logid, wait."""
    if args.file:
        text = Path(args.file).read_text(encoding="utf-8")
    else:
        text = sys.stdin.read()
    if "devices:" not in text:
        return _fail("cfg text must contain devices: (…)")

    cfg = Path(args.dest)
    if cfg.exists():
        bak = cfg.with_name(cfg.name + ".bak.mxmaster")
        bak.write_text(cfg.read_text(encoding="utf-8"), encoding="utf-8")
        backup = str(bak)
    else:
        backup = None

    cfg.write_text(text, encoding="utf-8")
    r = subprocess.run(
        ["systemctl", "restart", "logid"],
        text=True,
        capture_output=True,
        check=False,
    )
    if r.returncode != 0:
        return _fail(
            "systemctl restart logid failed: " + (r.stderr.strip() or r.stdout.strip()),
            wrote=str(cfg),
            backup=backup,
        )

    # Wait briefly for device node (Bolt often needs mouse move / USB wake).
    found: list[str] = []
    for _ in range(15):
        time.sleep(0.4)
        found = _device_paths()
        if found:
            break

    woke = False
    if not found and not args.no_wake:
        woke = _wake_bolt_receiver()
        for _ in range(20):
            time.sleep(0.5)
            found = _device_paths()
            if found:
                break

    quirk = None
    if not found:
        quirk = (
            "Cfg applied and logid restarted, but no device yet. "
            "Move the MX Master 3S (Bolt) and Refresh in the GUI."
        )

    return _ok(
        {
            "wrote": str(cfg),
            "backup": backup,
            "restarted": True,
            "bolt_usb_wake": woke,
            "devices": found,
            "quirk": quirk,
        }
    )


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="mxmaster-cfg-helper")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status", help="logid + devices + Bolt quirk hint")
    sub.add_parser("list-devices", help="alias of status")

    g = sub.add_parser("get-dpi")
    g.add_argument("--device", type=int, default=0)
    g.add_argument("--sensor", type=int, default=0)

    s = sub.add_parser("set-dpi")
    s.add_argument("--device", type=int, default=0)
    s.add_argument("--sensor", type=int, default=0)
    s.add_argument("--dpi", type=int, required=True)

    b = sub.add_parser("set-button-action", help="live Button.SetAction")
    b.add_argument("--device", type=int, default=0)
    b.add_argument("--cid", required=True, help="e.g. 0x56 or 86")
    b.add_argument(
        "--preset",
        choices=["back", "forward", "none"],
        help="common Keypress presets",
    )
    b.add_argument("--action", help="raw libconfig action string")

    gs = sub.add_parser("get-smartshift")
    gs.add_argument("--device", type=int, default=0)

    ss = sub.add_parser("set-smartshift", help="live SmartShift (prefer apply-cfg)")
    ss.add_argument("--device", type=int, default=0)
    ss.add_argument("--on", choices=["true", "false"], default=None)
    ss.add_argument("--threshold", type=int, default=None)
    ss.add_argument("--torque", type=int, default=None)

    gh = sub.add_parser("get-hiresscroll", help="HiresScroll.GetConfig (hires/invert/target)")
    gh.add_argument("--device", type=int, default=0)

    sh = sub.add_parser(
        "set-hiresscroll",
        help="live HiresScroll SetHires/SetInvert/SetTarget (prefer apply-cfg)",
    )
    sh.add_argument("--device", type=int, default=0)
    sh.add_argument("--hires", choices=["true", "false"], default=None)
    sh.add_argument("--invert", choices=["true", "false"], default=None)
    sh.add_argument(
        "--target",
        choices=["true", "false"],
        default=None,
        help="divert wheel to logiops (HID++ Target / cfg target)",
    )

    gt = sub.add_parser(
        "get-thumbwheel",
        help="ThumbWheel.GetConfig (divert/invert, feature 0x2150)",
    )
    gt.add_argument("--device", type=int, default=0)

    st = sub.add_parser(
        "set-thumbwheel",
        help="live ThumbWheel SetDivert/SetInvert (prefer apply-cfg)",
    )
    st.add_argument("--device", type=int, default=0)
    st.add_argument("--divert", choices=["true", "false"], default=None)
    st.add_argument("--invert", choices=["true", "false"], default=None)

    gb = sub.add_parser(
        "get-battery",
        help="probe Unified Battery 0x1004 via logiops D-Bus (may be n/a)",
    )
    gb.add_argument("--device", type=int, default=0)

    a = sub.add_parser("apply-cfg", help="write logid.cfg + restart logid")
    a.add_argument("--file", help="path to cfg text (else stdin)")
    a.add_argument("--dest", default=str(DEFAULT_CFG))
    a.add_argument(
        "--no-wake",
        action="store_true",
        help="do not soft-reset Bolt USB if device missing after restart",
    )

    return p


def main(argv: list[str] | None = None) -> int:
    _must_root()
    if shutil.which("busctl") is None:
        return _fail("busctl not found")
    parser = build_parser()
    args = parser.parse_args(argv)
    dispatch = {
        "status": cmd_status,
        "list-devices": cmd_list_devices,
        "get-dpi": cmd_get_dpi,
        "set-dpi": cmd_set_dpi,
        "set-button-action": cmd_set_button_action,
        "get-smartshift": cmd_get_smartshift,
        "set-smartshift": cmd_set_smartshift,
        "get-hiresscroll": cmd_get_hiresscroll,
        "set-hiresscroll": cmd_set_hiresscroll,
        "get-thumbwheel": cmd_get_thumbwheel,
        "set-thumbwheel": cmd_set_thumbwheel,
        "get-battery": cmd_get_battery,
        "apply-cfg": cmd_apply_cfg,
    }
    return dispatch[args.cmd](args)


if __name__ == "__main__":
    raise SystemExit(main())
