def cmd_set_thumbwheel(args: argparse.Namespace) -> int:
    """Live ThumbWheel divert/invert via D-Bus. Prefer apply-cfg to persist.

    Left/right/tap/touch/proxy need gesture/action type strings and are better
    applied through cfg; this command only toggles divert/invert.
    """
    path = _device_index_path(args.device)
    if args.divert is None and args.invert is None:
        return _fail("provide at least one of --divert / --invert")

    errors: list[str] = []

    def _try_call(label: str, method: str, value: str) -> None:
        try:
            _call(path, IFACE_THUMBWHEEL, method, "b", value, timeout=10.0)
        except Exception as exc:  # noqa: BLE001
            errors.append(f"{label}: {exc}")

    if args.divert is not None:
        _try_call(
            "SetDivert", "SetDivert", "true" if args.divert == "true" else "false"
        )
    if args.invert is not None:
        _try_call(
            "SetInvert", "SetInvert", "true" if args.invert == "true" else "false"
        )

    data = {"path": path, **_read_thumbwheel(path)}
    tw = data.get("thumbwheel") or {}
    matched = True
    if args.divert is not None and bool(tw.get("divert")) != (args.divert == "true"):
        matched = False
    if args.invert is not None and bool(tw.get("invert")) != (args.invert == "true"):
        matched = False
    if matched and tw:
        if errors:
            data["dbus_warnings"] = errors
        return _ok(data)
    return _fail(
        "; ".join(errors) or "thumbwheel set failed",
        path=path,
        **{k: v for k, v in data.items() if k != "path"},
    )


def cmd_set_hiresscroll(args: argparse.Namespace) -> int:
    """Live HiresScroll via D-Bus. Prefer apply-cfg to persist across restart.

    SetHires / SetInvert / SetTarget often time out on Bolt (same as SmartShift
