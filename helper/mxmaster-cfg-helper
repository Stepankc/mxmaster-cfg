"""Privileged helper for MX Master configurator (run via pkexec as root).

Talks to logid on the system D-Bus (root-only stock policy) and can write
/etc/logid.cfg + restart logid. Invoked from the user-session GUI through
pkexec so Stepan sees a polkit password dialog.

Subcommands print JSON on stdout (ok/error). Exit 0 on success.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

SERVICE = "pizza.pixl.LogiOps"
ROOT = "/pizza/pixl/logiops"
IFACE_DEVICES = "pizza.pixl.LogiOps.Devices"
IFACE_DEVICE = "pizza.pixl.LogiOps.Device"
IFACE_DPI = "pizza.pixl.LogiOps.DPI"
IFACE_SMARTSHIFT = "pizza.pixl.LogiOps.SmartShift"
IFACE_HIRESSCROLL = "pizza.pixl.LogiOps.HiresScroll"
IFACE_THUMBWHEEL = "pizza.pixl.LogiOps.ThumbWheel"
IFACE_BATTERY = "pizza.pixl.LogiOps.Battery"
IFACE_BUTTON = "pizza.pixl.LogiOps.Button"
IFACE_BUTTONS = "pizza.pixl.LogiOps.Buttons"
DEFAULT_CFG = Path("/etc/logid.cfg")

# MX Master 3S remappable CIDs observed on spike (Bolt).
CID_BACK = 0x53
CID_FORWARD = 0x56
CID_GESTURE = 0xC3
CID_MODE = 0xC4


def _must_root() -> None:
    if os.geteuid() != 0:
        _fail("helper must run as root (use pkexec)", code=77)


def _ok(payload: dict[str, Any]) -> int:
    payload = {"ok": True, **payload}
    sys.stdout.write(json.dumps(payload, ensure_ascii=False) + "\n")
    return 0


def _fail(message: str, *, code: int = 1, **extra: Any) -> int:
    payload = {"ok": False, "error": message, **extra}
    sys.stdout.write(json.dumps(payload, ensure_ascii=False) + "\n")
    return code


def _busctl(args: list[str], *, timeout: float = 20.0) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["busctl", "--system", *args],
        text=True,
        capture_output=True,
        check=False,
        timeout=timeout,
    )


def _parse_busctl_variant(text: str) -> Any:
    """Parse a single busctl stdout line into a Python value (best-effort)."""
    text = text.strip()
    if not text:
        return None
    # Examples: 's "MX Master 3S"', 'q 1200', 'b true', 'aqqb 2 200 8000 50 true'
    m = re.match(r'^([a-zA-Z0-9\{\}]+)(?:\s+(.*))?$', text, re.DOTALL)
    if not m:
        return text
    sig, rest = m.group(1), (m.group(2) or "").strip()
    if sig == "s":
        # quoted string
        qm = re.match(r'^"(.*)"$', rest)
        return qm.group(1) if qm else rest
    if sig == "q" or sig == "u" or sig == "i" or sig == "n" or sig == "t" or sig == "x":
        return int(rest.split()[0])
    if sig == "y":
        return int(rest.split()[0])
    if sig == "b":
        return rest.split()[0] == "true"
    if sig.startswith("a"):
        # array: drop count if present for a{…} / aq etc.
        parts = rest.split()
        if not parts:
            return []
        # busctl prints: <n> <elems…> for fixed arrays sometimes
        try:
            n = int(parts[0])
            vals = parts[1:]
            if len(vals) >= n and sig in {"aq", "au", "ay", "as"}:
                if sig == "as":
                    # strings are quoted; fall through to raw
                    return rest
                return [int(v) if v.isdigit() else v for v in vals[:n]]
        except ValueError:
            pass
        return rest
    return text


def _get_property(path: str, iface: str, prop: str) -> Any:
    r = _busctl(["get-property", SERVICE, path, iface, prop])
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or r.stdout.strip() or f"get-property {prop}")
    return _parse_busctl_variant(r.stdout)


def _call(path: str, iface: str, method: str, *args: str, timeout: float = 20.0) -> str:
    r = _busctl(["call", SERVICE, path, iface, method, *args], timeout=timeout)
    if r.returncode != 0:
        err = r.stderr.strip() or r.stdout.strip() or f"call {method} failed"
        raise RuntimeError(err)
    return r.stdout.strip()


def _device_paths() -> list[str]:
    r = _busctl(["tree", SERVICE])
    if r.returncode != 0:
        return []
    paths: list[str] = []
    for line in r.stdout.splitlines():
        for token in line.split():
            if re.fullmatch(r"/pizza/pixl/logiops/devices/\d+", token):
                paths.append(token)
    return sorted(set(paths))


def _device_index_path(index: int) -> str:
    return f"{ROOT}/devices/{index}"


def cmd_status(_args: argparse.Namespace) -> int:
    logid_active = (
        subprocess.run(
            ["systemctl", "is-active", "logid"],
            text=True,
            capture_output=True,
            check=False,
        ).stdout.strip()
        == "active"
    )
    paths = _device_paths()
    devices: list[dict[str, Any]] = []
    quirk = None
    for path in paths:
        info: dict[str, Any] = {"path": path}
        try:
            info["name"] = _get_property(path, IFACE_DEVICE, "Name")
            info["product_id"] = _get_property(path, IFACE_DEVICE, "ProductID")
            info["active"] = _get_property(path, IFACE_DEVICE, "Active")
        except RuntimeError as exc:
            info["error"] = str(exc)
        try:
            dpi_out = _call(path, IFACE_DPI, "GetDPI", "y", "0", timeout=8.0)
            info["dpi"] = _parse_busctl_variant(dpi_out)
        except Exception as exc:  # noqa: BLE001
            info["dpi"] = None
            info["dpi_error"] = str(exc)
            quirk = (
                "Bolt: устройство видно, но GetDPI таймаутит — пошевелите мышь "
                "или дождитесь HID++ (иногда нужен soft USB reset ресивера)."
            )
        info.update(_read_smartshift(path))
        info.update(_read_hiresscroll(path))
        info.update(_read_thumbwheel(path))
        info.update(_read_battery(path))
        devices.append(info)

    if logid_active and not paths:
        quirk = (
            "Bolt: logid запущен, но MX Master ещё не в дереве D-Bus. "
            "Пошевелите мышь (Easy-Switch на канале Bolt). После restart "
            "устройство часто появляется только после движения."
        )

    return _ok(
        {
            "logid_active": logid_active,
            "service": SERVICE,
            "device_count": len(paths),
            "devices": devices,
            "quirk": quirk,
            "transport_hint": "bolt-first",
        }
    )


def _parse_yyy(text: str) -> list[int]:
    """Parse busctl ``yyy a b c`` (or bare ints) into three ints."""
    parts = text.strip().split()
    if parts and parts[0] == "yyy":
        parts = parts[1:]
    vals = [int(x) for x in parts[:3]]
    while len(vals) < 3:
        vals.append(0)
    return vals


def _parse_bbb(text: str) -> list[bool]:
    """Parse busctl ``bbb true false false`` into three bools."""
    parts = text.strip().split()
    if parts and parts[0] == "bbb":
        parts = parts[1:]
    vals: list[bool] = []
    for token in parts[:3]:
        vals.append(token == "true")
    while len(vals) < 3:
        vals.append(False)
    return vals


def _read_hiresscroll(path: str) -> dict[str, Any]:
    """Read HiresScroll.GetConfig → hires / invert / target (divert).

    logiops 0.3.5 IPC: ``bbb`` = (hires, invert, target). There is no separate
    ``divert`` field — HID++ Mode::Target is exposed as cfg ``target``.
    Defaults when unset (source getConfig): hires=true, invert=false, target=false.
    """
    out: dict[str, Any] = {}
    try:
        raw = _call(path, IFACE_HIRESSCROLL, "GetConfig", timeout=8.0)
        hires, invert, target = _parse_bbb(raw)
        out["hiresscroll"] = {
            "hires": hires,
            "invert": invert,
            "target": target,
            "divert": target,  # alias for HID++ divert
            "raw": raw,
            "methods": ["GetConfig", "SetHires", "SetInvert", "SetTarget", "SetUp", "SetDown"],
        }
    except Exception as exc:  # noqa: BLE001
        out["hiresscroll"] = None
        out["hiresscroll_error"] = str(exc)
    return out


def _parse_bb(text: str) -> list[bool]:
    """Parse busctl ``bb true false`` into two bools."""
    parts = text.strip().split()
    if parts and parts[0] == "bb":
        parts = parts[1:]
    vals: list[bool] = []
    for token in parts[:2]:
        vals.append(token == "true")
    while len(vals) < 2:
        vals.append(False)
    return vals


def _iface_present(path: str, iface: str) -> bool:
    """True if ``busctl introspect`` lists the interface on ``path``."""
    r = _busctl(["introspect", SERVICE, path])
    if r.returncode != 0:
        return False
    needle = iface
    for line in r.stdout.splitlines():
        # First column is NAME; interface rows start with the iface string.
        if line.startswith(needle) or f" {needle} " in f" {line} ":
            # Prefer exact first-token match (busctl column layout).
            first = line.split()[0] if line.split() else ""
            if first == needle:
                return True
    return False


def _read_thumbwheel(path: str) -> dict[str, Any]:
    """Read ThumbWheel.GetConfig → divert / invert (feature 0x2150).

    logiops 0.3.5 IPC: ``bb`` = (divert, invert). Left/right/tap/touch/proxy
    are cfg-only (SetLeft/… take gesture/action type strings; not in GetConfig).
    No haptic field in the logiops cfg schema.
    """
    out: dict[str, Any] = {}
    if not _iface_present(path, IFACE_THUMBWHEEL):
        out["thumbwheel"] = None
        out["thumbwheel_error"] = (
            "ThumbWheel interface missing (device without 0x2150?)"
        )
        return out
    try:
        raw = _call(path, IFACE_THUMBWHEEL, "GetConfig", timeout=8.0)
        divert, invert = _parse_bb(raw)
        out["thumbwheel"] = {
            "divert": divert,
            "invert": invert,
            "raw": raw,
            "feature": "0x2150",
            "methods": [
                "GetConfig",
                "SetDivert",
                "SetInvert",
                "SetLeft",
                "SetRight",
                "SetProxy",
                "SetTap",
                "SetTouch",
            ],
            "cfg_fields": [
                "divert",
                "invert",
                "left",
                "right",
                "proxy",
                "touch",
                "tap",
            ],
            "haptic_supported": False,
            "note": (
                "tap/touch/proxy/left/right persist via cfg; "
                "GetConfig only returns divert+invert. "
                "No haptic in logiops 0.3.5 schema."
            ),
        }
    except Exception as exc:  # noqa: BLE001
        out["thumbwheel"] = None
        out["thumbwheel_error"] = str(exc)
    return out


def _read_battery(path: str) -> dict[str, Any]:
    """Probe Unified Battery (HID++ 0x1004) via logiops D-Bus if exposed.

    logiops **0.3.5 does not** ship a Battery IPC interface (confirmed on
    MX Master 3S Bolt introspect). We still probe so a future logiops release
    that adds ``pizza.pixl.LogiOps.Battery`` (or Device battery props) lights up
    the GUI without code changes.
    """
    out: dict[str, Any] = {
        "battery_available": False,
        "battery": None,
    }
    # 1) Dedicated Battery interface (not present in 0.3.5).
    if _iface_present(path, IFACE_BATTERY):
        for method in ("GetBattery", "GetLevel", "GetConfig", "GetStatus"):
            try:
                raw = _call(path, IFACE_BATTERY, method, timeout=8.0)
                parsed = _parse_battery_payload(raw)
                if parsed:
                    out["battery_available"] = True
                    out["battery"] = {
                        **parsed,
                        "source": f"{IFACE_BATTERY}.{method}",
                        "feature": "0x1004",
                        "raw": raw,
                    }
                    return out
            except Exception:  # noqa: BLE001
                continue
        out["battery_error"] = (
            f"{IFACE_BATTERY} present but no readable Get* method succeeded"
        )
        return out

    # 2) Optional Device properties some forks might expose.
    for prop in ("BatteryPercentage", "BatteryLevel", "Battery", "Charge"):
        try:
            val = _get_property(path, IFACE_DEVICE, prop)
            pct = _coerce_percent(val)
            if pct is not None:
                out["battery_available"] = True
                out["battery"] = {
                    "percent": pct,
                    "charging": None,
                    "source": f"{IFACE_DEVICE}.{prop}",
                    "feature": "0x1004",
                }
                return out
        except Exception:  # noqa: BLE001
            continue

    out["battery_error"] = (
        "logiops D-Bus has no Battery interface "
        f"(expected {IFACE_BATTERY} / HID++ 0x1004). "
        "Packaged logiops 0.3.5 does not expose Unified Battery over IPC."
    )
    return out


def _coerce_percent(val: Any) -> int | None:
    if isinstance(val, bool):
        return None
    if isinstance(val, int):
        return max(0, min(100, val))
    if isinstance(val, float):
        return max(0, min(100, int(round(val))))
    if isinstance(val, str) and val.isdigit():
        return max(0, min(100, int(val)))
    return None


def _parse_battery_payload(raw: str) -> dict[str, Any] | None:
    """Best-effort parse of hypothetical Battery Get* busctl output."""
    text = raw.strip()
    if not text:
        return None
    parts = text.split()
    # Drop leading signature token(s) like "y", "yb", "yy", "u", "uu"…
    sig = parts[0] if parts else ""
    rest = parts[1:] if sig and re.fullmatch(r"[a-zA-Z0-9\{\}]+", sig) else parts
    if not rest:
        return None
    # Prefer first integer 0–100 as percent; look for a following bool as charging.
    percent: int | None = None
    charging: bool | None = None
    for token in rest:
        if token in {"true", "false"} and charging is None and percent is not None:
            charging = token == "true"
            continue
        try:
            n = int(token)
        except ValueError:
            continue
        if percent is None and 0 <= n <= 100:
            percent = n
        elif charging is None and n in (0, 1):
            charging = bool(n)
    if percent is None:
        return None
    return {"percent": percent, "charging": charging}


def _read_smartshift(path: str) -> dict[str, Any]:
    out: dict[str, Any] = {}
    try:
        torque_support = _get_property(path, IFACE_SMARTSHIFT, "TorqueSupport")
        out["smartshift_torque_support"] = bool(torque_support)
    except Exception as exc:  # noqa: BLE001
        out["smartshift_torque_support"] = False
        out["smartshift_error"] = str(exc)
        return out
    try:
        raw = _call(path, IFACE_SMARTSHIFT, "GetConfig", timeout=8.0)
        mode, threshold, torque = _parse_yyy(raw)
        # logiops SmartShift::IPC::getConfig (v0.3.x): first byte is CONFIG
        # tri-state for optional `on`, NOT raw HID++ ratchet:
        #   0 = on unset (cleared), 1 = on:false, 2 = on:true
        # See PixlOne/logiops src/logid/features/SmartShift.cpp getConfig().
        if mode == 2:
            on: bool | None = True
            on_state = "on"
        elif mode == 1:
            on = False
            on_state = "off"
        else:
            on = None
            on_state = "unset"
        out["smartshift"] = {
            "mode": mode,
            "on": on,
            "on_state": on_state,
            "threshold": threshold,
            "torque": torque,
            "raw": raw,
        }
    except Exception as exc:  # noqa: BLE001
        out["smartshift"] = None
        out["smartshift_error"] = str(exc)
    return out


