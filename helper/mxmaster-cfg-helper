    """
    path = _device_index_path(args.device)
    if args.hires is None and args.invert is None and args.target is None:
        return _fail("provide at least one of --hires / --invert / --target")

    errors: list[str] = []

    def _try_call(label: str, method: str, value: str) -> None:
        try:
            _call(path, IFACE_HIRESSCROLL, method, "b", value, timeout=10.0)
        except Exception as exc:  # noqa: BLE001
            errors.append(f"{label}: {exc}")

    if args.hires is not None:
        _try_call("SetHires", "SetHires", "true" if args.hires == "true" else "false")
    if args.invert is not None:
        _try_call(
            "SetInvert", "SetInvert", "true" if args.invert == "true" else "false"
        )
    if args.target is not None:
        _try_call(
            "SetTarget", "SetTarget", "true" if args.target == "true" else "false"
        )

    data = {"path": path, **_read_hiresscroll(path)}
    hs = data.get("hiresscroll") or {}
    matched = True
    if args.hires is not None and bool(hs.get("hires")) != (args.hires == "true"):
        matched = False
    if args.invert is not None and bool(hs.get("invert")) != (args.invert == "true"):
        matched = False
    if args.target is not None and bool(hs.get("target")) != (args.target == "true"):
        matched = False
    if matched and hs:
        if errors:
