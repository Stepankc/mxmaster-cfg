"""Privileged helper for MX Master configurator (run via pkexec as root).

Talks to logid on the system D-Bus (root-only stock policy) and can write
/etc/logid.cfg + restart logid. Invoked from the user-session GUI through
pkexec so Stepan sees a polkit password dialog.

Subcommands print JSON on stdout (ok/error). Exit 0 on success.
"""

from __future__ import annotations

import argparse
import glob
import json
import os
import re
import select
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

SERVICE = "pizza.pixl.LogiOps"
ROOT = "/pizza/pixl/logiops"
IFACE_DEVICES = "pizza.pixl.LogiOps.Devices"
IFACE_DEVICE = "pizza.pixl.LogiOps.Device"
IFACE_DPI = "pizza.pixl.LogiOps.DPI"
IFACE_SMARTSHIFT = "pizza.pixl.LogiOps.SmartShift"
IFACE_HIRESSCROLL = "pizza.pixl.LogiOps.HiresScroll"
IFACE_THUMBWHEEL = "pizza.pixl.LogiOps.ThumbWheel"
IFACE_BATTERY = "pizza.pixl.LogiOps.Battery"
IFACE_BUTTON = "pizza.pixl.LogiOps.Button"
IFACE_BUTTONS = "pizza.pixl.LogiOps.Buttons"
DEFAULT_CFG = Path("/etc/logid.cfg")

# MX Master 3S remappable CIDs observed on spike (Bolt).
CID_BACK = 0x53
CID_FORWARD = 0x56
CID_GESTURE = 0xC3
CID_MODE = 0xC4

# HID++ 2.0 — Unified Battery (0x1004). Distinct software id so replies
# are not confused with logid's own traffic when probing alongside it.
HIDPP_SW_ID = 0x0B
HIDPP_FEATURE_UNIFIED_BATTERY = 0x1004
# Bolt / Unifying receivers + MX Master 3S Bluetooth (direct).
HIDPP_RECEIVER_PIDS = {"c548", "c52b", "c532", "c52f"}
HIDPP_DIRECT_PIDS = {"b034", "b023", "b019"}  # 3S / 3 / 2S BT examples


def _must_root() -> None:
    if os.geteuid() != 0:
        _fail("helper must run as root (use pkexec)", code=77)


def _ok(payload: dict[str, Any]) -> int:
    payload = {"ok": True, **payload}
    sys.stdout.write(json.dumps(payload, ensure_ascii=False) + "\n")
    return 0


def _fail(message: str, *, code: int = 1, **extra: Any) -> int:
    payload = {"ok": False, "error": message, **extra}
    sys.stdout.write(json.dumps(payload, ensure_ascii=False) + "\n")
    return code


def _busctl(args: list[str], *, timeout: float = 20.0) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["busctl", "--system", *args],
        text=True,
        capture_output=True,
        check=False,
        timeout=timeout,
    )


def _parse_busctl_variant(text: str) -> Any:
    """Parse a single busctl stdout line into a Python value (best-effort)."""
    text = text.strip()
    if not text:
        return None
    # Examples: 's "MX Master 3S"', 'q 1200', 'b true', 'aqqb 2 200 8000 50 true'
    m = re.match(r'^([a-zA-Z0-9\{\}]+)(?:\s+(.*))?$', text, re.DOTALL)
    if not m:
        return text
    sig, rest = m.group(1), (m.group(2) or "").strip()
    if sig == "s":
        # quoted string
        qm = re.match(r'^"(.*)"$', rest)
        return qm.group(1) if qm else rest
    if sig == "q" or sig == "u" or sig == "i" or sig == "n" or sig == "t" or sig == "x":
        return int(rest.split()[0])
    if sig == "y":
        return int(rest.split()[0])
    if sig == "b":
        return rest.split()[0] == "true"
    if sig.startswith("a"):
        # array: drop count if present for a{…} / aq etc.
        parts = rest.split()
        if not parts:
            return []
        # busctl prints: <n> <elems…> for fixed arrays sometimes
        try:
            n = int(parts[0])
            vals = parts[1:]
            if len(vals) >= n and sig in {"aq", "au", "ay", "as"}:
                if sig == "as":
                    # strings are quoted; fall through to raw
                    return rest
                return [int(v) if v.isdigit() else v for v in vals[:n]]
        except ValueError:
            pass
        return rest
    return text


def _get_property(path: str, iface: str, prop: str) -> Any:
    r = _busctl(["get-property", SERVICE, path, iface, prop])
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or r.stdout.strip() or f"get-property {prop}")
    return _parse_busctl_variant(r.stdout)


def _call(path: str, iface: str, method: str, *args: str, timeout: float = 20.0) -> str:
    r = _busctl(["call", SERVICE, path, iface, method, *args], timeout=timeout)
    if r.returncode != 0:
        err = r.stderr.strip() or r.stdout.strip() or f"call {method} failed"
        raise RuntimeError(err)
    return r.stdout.strip()


def _device_paths() -> list[str]:
    r = _busctl(["tree", SERVICE])
    if r.returncode != 0:
        return []
    paths: list[str] = []
    for line in r.stdout.splitlines():
        for token in line.split():
            if re.fullmatch(r"/pizza/pixl/logiops/devices/\d+", token):
                paths.append(token)
    return sorted(set(paths))


def _device_index_path(index: int) -> str:
    return f"{ROOT}/devices/{index}"


def cmd_status(_args: argparse.Namespace) -> int:
    logid_active = (
        subprocess.run(
            ["systemctl", "is-active", "logid"],
            text=True,
            capture_output=True,
            check=False,
        ).stdout.strip()
        == "active"
    )
    paths = _device_paths()
    devices: list[dict[str, Any]] = []
    quirk = None
    for path in paths:
        info: dict[str, Any] = {"path": path}
        try:
            info["name"] = _get_property(path, IFACE_DEVICE, "Name")
            info["product_id"] = _get_property(path, IFACE_DEVICE, "ProductID")
            info["active"] = _get_property(path, IFACE_DEVICE, "Active")
        except RuntimeError as exc:
            info["error"] = str(exc)
        try:
            dpi_out = _call(path, IFACE_DPI, "GetDPI", "y", "0", timeout=8.0)
            info["dpi"] = _parse_busctl_variant(dpi_out)
        except Exception as exc:  # noqa: BLE001
            info["dpi"] = None
            info["dpi_error"] = str(exc)
            quirk = (
                "Bolt: устройство видно, но GetDPI таймаутит — пошевелите мышь "
                "или дождитесь HID++ (иногда нужен soft USB reset ресивера)."
            )
        info.update(_read_smartshift(path))
        info.update(_read_hiresscroll(path))
        info.update(_read_thumbwheel(path))
        info.update(_read_battery(path))
        devices.append(info)

    if logid_active and not paths:
        quirk = (
            "Bolt: logid запущен, но MX Master ещё не в дереве D-Bus. "
            "Пошевелите мышь (Easy-Switch на канале Bolt). После restart "
            "устройство часто появляется только после движения."
        )

    return _ok(
        {
            "logid_active": logid_active,
            "service": SERVICE,
            "device_count": len(paths),
            "devices": devices,
            "quirk": quirk,
            "transport_hint": "bolt-first",
        }
    )


def _parse_yyy(text: str) -> list[int]:
    """Parse busctl ``yyy a b c`` (or bare ints) into three ints."""
    parts = text.strip().split()
    if parts and parts[0] == "yyy":
        parts = parts[1:]
    vals = [int(x) for x in parts[:3]]
    while len(vals) < 3:
        vals.append(0)
    return vals


def _parse_bbb(text: str) -> list[bool]:
    """Parse busctl ``bbb true false false`` into three bools."""
    parts = text.strip().split()
    if parts and parts[0] == "bbb":
        parts = parts[1:]
    vals: list[bool] = []
    for token in parts[:3]:
        vals.append(token == "true")
    while len(vals) < 3:
        vals.append(False)
    return vals


def _read_hiresscroll(path: str) -> dict[str, Any]:
    """Read HiresScroll.GetConfig → hires / invert / target (divert).

    logiops 0.3.5 IPC: ``bbb`` = (hires, invert, target). There is no separate
    ``divert`` field — HID++ Mode::Target is exposed as cfg ``target``.
    Defaults when unset (source getConfig): hires=true, invert=false, target=false.
    """
    out: dict[str, Any] = {}
    try:
        raw = _call(path, IFACE_HIRESSCROLL, "GetConfig", timeout=8.0)
        hires, invert, target = _parse_bbb(raw)
        out["hiresscroll"] = {
            "hires": hires,
            "invert": invert,
            "target": target,
            "divert": target,  # alias for HID++ divert
            "raw": raw,
            "methods": ["GetConfig", "SetHires", "SetInvert", "SetTarget", "SetUp", "SetDown"],
        }
    except Exception as exc:  # noqa: BLE001
        out["hiresscroll"] = None
        out["hiresscroll_error"] = str(exc)
    return out


def _parse_bb(text: str) -> list[bool]:
    """Parse busctl ``bb true false`` into two bools."""
    parts = text.strip().split()
    if parts and parts[0] == "bb":
        parts = parts[1:]
    vals: list[bool] = []
    for token in parts[:2]:
        vals.append(token == "true")
    while len(vals) < 2:
        vals.append(False)
    return vals


def _iface_present(path: str, iface: str) -> bool:
    """True if ``busctl introspect`` lists the interface on ``path``."""
    r = _busctl(["introspect", SERVICE, path])
    if r.returncode != 0:
        return False
    needle = iface
    for line in r.stdout.splitlines():
        # First column is NAME; interface rows start with the iface string.
        if line.startswith(needle) or f" {needle} " in f" {line} ":
            # Prefer exact first-token match (busctl column layout).
            first = line.split()[0] if line.split() else ""
            if first == needle:
                return True
    return False


def _read_thumbwheel(path: str) -> dict[str, Any]:
    """Read ThumbWheel.GetConfig → divert / invert (feature 0x2150).

    logiops 0.3.5 IPC: ``bb`` = (divert, invert). Left/right/tap/touch/proxy
    are cfg-only (SetLeft/… take gesture/action type strings; not in GetConfig).
    No haptic field in the logiops cfg schema.
    """
    out: dict[str, Any] = {}
    if not _iface_present(path, IFACE_THUMBWHEEL):
        out["thumbwheel"] = None
        out["thumbwheel_error"] = (
            "ThumbWheel interface missing (device without 0x2150?)"
        )
        return out
    try:
        raw = _call(path, IFACE_THUMBWHEEL, "GetConfig", timeout=8.0)
        divert, invert = _parse_bb(raw)
        out["thumbwheel"] = {
            "divert": divert,
            "invert": invert,
            "raw": raw,
            "feature": "0x2150",
            "methods": [
                "GetConfig",
                "SetDivert",
                "SetInvert",
                "SetLeft",
                "SetRight",
                "SetProxy",
                "SetTap",
                "SetTouch",
            ],
            "cfg_fields": [
                "divert",
                "invert",
                "left",
                "right",
                "proxy",
                "touch",
                "tap",
            ],
            "haptic_supported": False,
            "note": (
                "tap/touch/proxy/left/right persist via cfg; "
                "GetConfig only returns divert+invert. "
                "No haptic in logiops 0.3.5 schema."
            ),
        }
    except Exception as exc:  # noqa: BLE001
        out["thumbwheel"] = None
        out["thumbwheel_error"] = str(exc)
    return out


def _read_battery(
    path: str | None = None,
    *,
    allow_stop_logid: bool = True,
) -> dict[str, Any]:
    """Resolve battery % / charging via D-Bus → UPower/sysfs → HID++ hidraw.

    Packaged logiops **0.3.5** has no ``pizza.pixl.LogiOps.Battery`` IPC.
    On Logi Bolt (MX Master 3S) UPower/sysfs also stay empty while the kernel
    uses ``hid-generic``. Real % comes from a short HID++ Unified Battery
    (``0x1004``) probe on the receiver hidraw — verified to coexist with a
    running ``logid`` (no stop required). If the open/xfer fails, we briefly
    stop/start logid for one read as a fallback (unless
    ``allow_stop_logid=False``).
    """
    out: dict[str, Any] = {
        "battery_available": False,
        "battery": None,
    }
    errors: list[str] = []

    # 1) logiops D-Bus Battery (future-proof; absent on 0.3.5).
    if path:
        dbus = _read_battery_dbus(path)
        if dbus.get("battery_available"):
            return dbus
        if dbus.get("battery_error"):
            errors.append(str(dbus["battery_error"]))

    # 2) UPower / sysfs (often works for Bluetooth; empty on Bolt+hid-generic).
    up = _read_battery_upower_sysfs()
    if up is not None:
        out["battery_available"] = True
        out["battery"] = up
        return out
    errors.append("UPower/sysfs: no Logitech mouse battery")

    # 3) HID++ hidraw probe (Bolt / Unifying / BT direct).
    hid = _read_battery_hidpp(allow_stop_logid=allow_stop_logid)
    if hid is not None:
        out["battery_available"] = True
        out["battery"] = hid
        return out
    errors.append("HID++ 0x1004 hidraw probe failed")

    out["battery_error"] = "; ".join(errors)
    return out


def _read_battery_dbus(path: str) -> dict[str, Any]:
    """Probe logiops Battery interface / Device properties if present."""
    out: dict[str, Any] = {
        "battery_available": False,
        "battery": None,
    }
    if _iface_present(path, IFACE_BATTERY):
        for method in ("GetBattery", "GetLevel", "GetConfig", "GetStatus"):
            try:
                raw = _call(path, IFACE_BATTERY, method, timeout=8.0)
                parsed = _parse_battery_payload(raw)
                if parsed:
                    out["battery_available"] = True
                    out["battery"] = {
                        **parsed,
                        "source": f"{IFACE_BATTERY}.{method}",
                        "feature": "0x1004",
                        "raw": raw,
                    }
                    return out
            except Exception:  # noqa: BLE001
                continue
        out["battery_error"] = (
            f"{IFACE_BATTERY} present but no readable Get* method succeeded"
        )
        return out

    for prop in ("BatteryPercentage", "BatteryLevel", "Battery", "Charge"):
        try:
            val = _get_property(path, IFACE_DEVICE, prop)
            pct = _coerce_percent(val)
            if pct is not None:
                out["battery_available"] = True
                out["battery"] = {
                    "percent": pct,
                    "charging": None,
                    "status": None,
                    "source": f"{IFACE_DEVICE}.{prop}",
                    "feature": "0x1004",
                }
                return out
        except Exception:  # noqa: BLE001
            continue

    out["battery_error"] = (
        "logiops D-Bus has no Battery interface "
        f"(expected {IFACE_BATTERY} / HID++ 0x1004)"
    )
    return out


def _coerce_percent(val: Any) -> int | None:
    if isinstance(val, bool):
        return None
    if isinstance(val, int):
        return max(0, min(100, val))
    if isinstance(val, float):
        return max(0, min(100, int(round(val))))
    if isinstance(val, str) and val.isdigit():
        return max(0, min(100, int(val)))
    return None


def _parse_battery_payload(raw: str) -> dict[str, Any] | None:
    """Best-effort parse of hypothetical Battery Get* busctl output."""
    text = raw.strip()
    if not text:
        return None
    parts = text.split()
    # Drop leading signature token(s) like "y", "yb", "yy", "u", "uu"…
    sig = parts[0] if parts else ""
    rest = parts[1:] if sig and re.fullmatch(r"[a-zA-Z0-9\{\}]+", sig) else parts
    if not rest:
        return None
    # Prefer first integer 0–100 as percent; look for a following bool as charging.
    percent: int | None = None
    charging: bool | None = None
    for token in rest:
        if token in {"true", "false"} and charging is None and percent is not None:
            charging = token == "true"
            continue
        try:
            n = int(token)
        except ValueError:
            continue
        if percent is None and 0 <= n <= 100:
            percent = n
        elif charging is None and n in (0, 1):
            charging = bool(n)
    if percent is None:
        return None
    return {"percent": percent, "charging": charging, "status": None}


def _map_unified_battery_status(status_byte: int) -> tuple[bool | None, str]:
    """Map HID++ 0x1004 GetStatus status byte → (charging, status name).

    0=discharging, 1=recharging, 2=almost full (still charging), 3=full,
    4=error (kernel / Solaar convention).
    """
    if status_byte == 0:
        return False, "discharging"
    if status_byte in (1, 2):
        return True, "charging" if status_byte == 1 else "almost_full"
    if status_byte == 3:
        return False, "full"
    if status_byte == 4:
        return None, "error"
    return None, f"unknown_{status_byte}"


def _read_battery_upower_sysfs() -> dict[str, Any] | None:
    """Read Logitech mouse battery from sysfs power_supply or UPower."""
    # sysfs first (kernel hid-logitech-hidpp exports this for some BT mice).
    ps_root = Path("/sys/class/power_supply")
    if ps_root.is_dir():
        for entry in sorted(ps_root.iterdir()):
            try:
                name = entry.name.lower()
                model = _read_sysfs_str(entry / "model_name")
                manuf = _read_sysfs_str(entry / "manufacturer")
                scope = _read_sysfs_str(entry / "scope")
                blob = " ".join(
                    x for x in (name, model or "", manuf or "", scope or "") if x
                ).lower()
                if not any(
                    k in blob
                    for k in (
                        "logitech",
                        "mx master",
                        "hidpp",
                        "046d",
                        "mouse",
                    )
                ):
                    # Skip laptop / UPS batteries.
                    if "bat" in name and "hid" not in name and "logitech" not in blob:
                        continue
                    if "hid" not in name and "logitech" not in blob:
                        continue
                cap = _read_sysfs_str(entry / "capacity")
                pct = _coerce_percent(int(cap) if cap and cap.isdigit() else None)
                if pct is None:
                    continue
                st = (_read_sysfs_str(entry / "status") or "").lower()
                charging: bool | None
                status: str
                if st == "charging":
                    charging, status = True, "charging"
                elif st == "full":
                    charging, status = False, "full"
                elif st == "discharging":
                    charging, status = False, "discharging"
                else:
                    charging, status = None, st or "unknown"
                return {
                    "percent": pct,
                    "charging": charging,
                    "status": status,
                    "source": f"sysfs:{entry.name}",
                    "feature": "power_supply",
                    "model": model,
                }
            except (OSError, ValueError):
                continue

    # UPower EnumerateDevices (Bluetooth LE Battery often appears here).
    if shutil.which("busctl") is None:
        return None
    r = subprocess.run(
        [
            "busctl",
            "--system",
            "call",
            "org.freedesktop.UPower",
            "/org/freedesktop/UPower",
            "org.freedesktop.UPower",
            "EnumerateDevices",
        ],
        text=True,
        capture_output=True,
        check=False,
        timeout=10,
    )
    if r.returncode != 0:
        return None
    paths = re.findall(r"/org/freedesktop/UPower/devices/[A-Za-z0-9_]+", r.stdout)
    for upath in paths:
        try:
            model = _upower_prop(upath, "Model")
            vendor = _upower_prop(upath, "Vendor")
            native = _upower_prop(upath, "NativePath")
            # Type: 2 = Battery
            typ = _upower_prop(upath, "Type")
            blob = " ".join(
                str(x) for x in (model, vendor, native, upath) if x is not None
            ).lower()
            if not any(
                k in blob for k in ("logitech", "mx master", "mouse", "hidpp", "046d")
            ):
                continue
            if typ is not None and int(typ) not in (0, 2):  # 0 unknown, 2 battery
                # Still allow if name clearly matches a mouse.
                if "mouse" not in blob and "mx master" not in blob:
                    continue
            pct_raw = _upower_prop(upath, "Percentage")
            pct = _coerce_percent(
                int(round(float(pct_raw))) if pct_raw is not None else None
            )
            if pct is None:
                continue
            # State: 1 charging, 2 discharging, 3 empty, 4 fully charged, …
            state = _upower_prop(upath, "State")
            state_i = int(state) if state is not None else -1
            if state_i == 1:
                charging, status = True, "charging"
            elif state_i == 2:
                charging, status = False, "discharging"
            elif state_i == 4:
                charging, status = False, "full"
            else:
                charging, status = None, f"upower_state_{state_i}"
            return {
                "percent": pct,
                "charging": charging,
                "status": status,
                "source": f"upower:{upath.rsplit('/', 1)[-1]}",
                "feature": "UPower",
                "model": model,
            }
        except (TypeError, ValueError, RuntimeError):
            continue
    return None


def _read_sysfs_str(path: Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError:
        return None


def _upower_prop(path: str, prop: str) -> Any:
    r = subprocess.run(
        [
            "busctl",
            "--system",
            "get-property",
            "org.freedesktop.UPower",
            path,
            "org.freedesktop.UPower.Device",
            prop,
        ],
        text=True,
        capture_output=True,
        check=False,
        timeout=5,
    )
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or f"upower {prop}")
    return _parse_busctl_variant(r.stdout.strip())


def _hidpp_candidate_nodes() -> list[str]:
    """hidraw nodes likely carrying HID++ short/long reports (0x10 / 0x11)."""
    nodes: list[str] = []
    for uevent in sorted(glob.glob("/sys/class/hidraw/hidraw*/device/uevent")):
        try:
            text = Path(uevent).read_text(encoding="utf-8")
        except OSError:
            continue
        m = re.search(r"HID_ID=0003:0000046D:0000([0-9A-Fa-f]{4})", text)
        if not m:
            continue
        pid = m.group(1).lower()
        if pid not in HIDPP_RECEIVER_PIDS and pid not in HIDPP_DIRECT_PIDS:
            continue
        desc_path = Path(uevent).parent / "report_descriptor"
        try:
            desc = desc_path.read_bytes()
        except OSError:
            continue
        # Vendor collection with Report ID 0x10 (HID++ short).
        if b"\x85\x10" not in desc:
            continue
        name = Path(uevent).parent.parent.name  # hidrawN
        nodes.append(f"/dev/{name}")
    return nodes


def _hidpp_drain(fd: int) -> None:
    while True:
        ready, _, _ = select.select([fd], [], [], 0)
        if not ready:
            break
        try:
            os.read(fd, 64)
        except OSError:
            break


def _hidpp_xfer(fd: int, req: bytes, *, timeout: float = 1.2) -> bytes | None:
    """Write a HID++ request and wait for a matching software-id reply."""
    _hidpp_drain(fd)
    os.write(fd, req)
    end = time.time() + timeout
    sw = req[3] & 0x0F
    dev = req[1]
    while time.time() < end:
        ready, _, _ = select.select([fd], [], [], 0.2)
        if not ready:
            continue
        try:
            data = os.read(fd, 64)
        except OSError:
            continue
        if len(data) < 4:
            continue
        if data[1] != dev:
            continue
        # Protocol error replies use sub_id 0x8f / 0xff.
        if data[2] in (0x8F, 0xFF):
            return data
        if (data[3] & 0x0F) == sw:
            return data
    return None


def _hidpp_get_feature_index(fd: int, device_index: int, feature: int) -> int | None:
    """Root (0x0000) GetFeature → feature index, or None if absent/error."""
    req = bytes(
        [
            0x10,
            device_index & 0xFF,
            0x00,  # Root feature index
            (0x00 << 4) | HIDPP_SW_ID,  # GetFeature fn=0
            (feature >> 8) & 0xFF,
            feature & 0xFF,
            0x00,
        ]
    )
    rep = _hidpp_xfer(fd, req, timeout=0.9)
    if rep is None or len(rep) < 5:
        return None
    if rep[2] in (0x8F, 0xFF):
        return None
    # Success: feature index in params[0] (byte 4); 0 means not found on some
    # devices — treat 0 as missing unless feature was Root itself.
    idx = rep[4]
    if idx == 0 and feature != 0x0000:
        return None
    return idx


def _hidpp_unified_battery_on_fd(
    fd: int, device_index: int
) -> dict[str, Any] | None:
    feat_idx = _hidpp_get_feature_index(
        fd, device_index, HIDPP_FEATURE_UNIFIED_BATTERY
    )
    if feat_idx is None:
        return None
    # GetStatus function 1.
    req = bytes(
        [
            0x10,
            device_index & 0xFF,
            feat_idx & 0xFF,
            (0x01 << 4) | HIDPP_SW_ID,
            0x00,
            0x00,
            0x00,
        ]
    )
    rep = _hidpp_xfer(fd, req, timeout=1.5)
    if rep is None or len(rep) < 7:
        return None
    if rep[2] in (0x8F, 0xFF):
        return None
    percent = int(rep[4])
    level = int(rep[5])
    status_byte = int(rep[6])
    if percent < 0 or percent > 100:
        return None
    charging, status = _map_unified_battery_status(status_byte)
    return {
        "percent": percent,
        "charging": charging,
        "status": status,
        "level_bitmask": level,
        "status_byte": status_byte,
        "feature": "0x1004",
        "feature_index": feat_idx,
        "device_index": device_index,
        "raw": rep.hex(),
    }


def _hidpp_probe_on_nodes(
    nodes: list[str],
) -> dict[str, Any] | None:
    # Receivers: try slots 1–6. Direct BT/USB: device index 0xFF (and 0x01).
    slot_sets = (
        list(range(1, 7)) + [0xFF, 0x01]
    )
    for node in nodes:
        try:
            fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)
        except OSError:
            continue
        try:
            for slot in slot_sets:
                bat = _hidpp_unified_battery_on_fd(fd, slot)
                if bat is not None:
                    bat["source"] = f"hidpp:{node}"
                    bat["hidraw"] = node
                    return bat
        finally:
            os.close(fd)
    return None


def _logid_was_active() -> bool:
    return (
        subprocess.run(
            ["systemctl", "is-active", "--quiet", "logid"],
            check=False,
        ).returncode
        == 0
    )


def _restart_logid_and_wait(*, wake: bool = True) -> None:
    subprocess.run(
        ["systemctl", "start", "logid"],
        check=False,
        capture_output=True,
        text=True,
    )
    found: list[str] = []
    for _ in range(15):
        time.sleep(0.35)
        found = _device_paths()
        if found:
            return
    if wake:
        _wake_bolt_receiver()
        for _ in range(20):
            time.sleep(0.4)
            if _device_paths():
                return


def _read_battery_hidpp(*, allow_stop_logid: bool = True) -> dict[str, Any] | None:
    """Short Unified Battery probe; prefer coexistence with running logid."""
    nodes = _hidpp_candidate_nodes()
    if not nodes:
        return None

    # Prefer without stopping logid (works on Bolt MX Master 3S smoke).
    bat = _hidpp_probe_on_nodes(nodes)
    if bat is not None:
        bat["logid_stopped"] = False
        return bat

    if not allow_stop_logid:
        return None

    was_active = _logid_was_active()
    if was_active:
        subprocess.run(
            ["systemctl", "stop", "logid"],
            check=False,
            capture_output=True,
            text=True,
        )
        time.sleep(0.4)
    try:
        # hidraw nodes can renumber after USB events; refresh list.
        nodes = _hidpp_candidate_nodes() or nodes
        bat = _hidpp_probe_on_nodes(nodes)
        if bat is not None:
            bat["logid_stopped"] = bool(was_active)
            bat["source"] = bat.get("source", "hidpp") + "+logid-stop"
            return bat
        return None
    finally:
        if was_active:
            _restart_logid_and_wait(wake=True)


def _read_smartshift(path: str) -> dict[str, Any]:
    out: dict[str, Any] = {}
    try:
        torque_support = _get_property(path, IFACE_SMARTSHIFT, "TorqueSupport")
        out["smartshift_torque_support"] = bool(torque_support)
    except Exception as exc:  # noqa: BLE001
        out["smartshift_torque_support"] = False
        out["smartshift_error"] = str(exc)
        return out
    try:
        raw = _call(path, IFACE_SMARTSHIFT, "GetConfig", timeout=8.0)
        mode, threshold, torque = _parse_yyy(raw)
        # logiops SmartShift::IPC::getConfig (v0.3.x): first byte is CONFIG
        # tri-state for optional `on`, NOT raw HID++ ratchet:
        #   0 = on unset (cleared), 1 = on:false, 2 = on:true
        # See PixlOne/logiops src/logid/features/SmartShift.cpp getConfig().
        if mode == 2:
            on: bool | None = True
            on_state = "on"
        elif mode == 1:
            on = False
            on_state = "off"
        else:
            on = None
            on_state = "unset"
        out["smartshift"] = {
            "mode": mode,
            "on": on,
            "on_state": on_state,
            "threshold": threshold,
            "torque": torque,
            "raw": raw,
        }
    except Exception as exc:  # noqa: BLE001
        out["smartshift"] = None
        out["smartshift_error"] = str(exc)
    return out


