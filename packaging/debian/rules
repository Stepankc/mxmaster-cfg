export DH_VERBOSE = 1
export PYBUILD_NAME = mxmaster-cfg

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	# Unit tests that need D-Bus/display stay optional; profile/cfg tests are
	# run in CI / locally via pytest. Skip here to keep Build-Depends light.
	@echo "skipping dh_auto_test (run: PYTHONPATH=src python3 -m pytest -q)"
